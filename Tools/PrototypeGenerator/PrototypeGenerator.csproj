<Project Sdk="Microsoft.NET.Sdk">

  <!-- A developer tool that writes a starting entity prototype for every Daggerfall model. Run once, then edit by hand. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The readers and converter, so the texture order matches the .glb files exactly. -->
    <ProjectReference Include="..\..\Importer\Importer.csproj" />
  </ItemGroup>

</Project>
